OPENAI_API_KEY=sk-...
SERPAPI_API_KEY=your-serpapi-key

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TOOL_SELECTION_TOP_K=4
# Minimum cosine similarity for a tool to be selected (0 disables the cutoff)
TOOL_SELECTION_MIN_SCORE=0.2
# Seconds to cache identical SerpAPI requests (saves API credits)
SERPAPI_CACHE_TTL=60
